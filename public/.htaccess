# 2240 Speed Shop — static export, shared LiteSpeed/Apache host.
#
# Everything here is guarded by IfModule: a host without the module ignores the
# block rather than throwing a 500. Three jobs only — compress the text, cache
# the fingerprinted assets forever, and serve the 3D formats with the right MIME
# type so the browser streams them instead of guessing.

# ── MIME ────────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType model/gltf-binary          .glb
  AddType image/ktx2                 .ktx2
  AddType application/wasm           .wasm
  AddType font/woff2                 .woff2
  AddType image/webp                 .webp
  AddType image/avif                 .avif
</IfModule>

# ── Compression ─────────────────────────────────────────────────────────────
# GLB, KTX2 and WOFF2 are already compressed — running deflate over them burns
# CPU on both ends for nothing, so they are deliberately absent from this list.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ── Cache ───────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Next fingerprints everything under /_next/static — safe to pin for a year.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The shop itself: models, transcoder, photographs. Content-addressed by
  # deploy rather than by name, so a month with revalidation, not a year.
  <FilesMatch "\.(glb|ktx2|wasm|jpg|jpeg|png|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML must never be sticky: the whole site is one deploy behind otherwise.
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType model/gltf-binary "access plus 1 month"
  ExpiresByType image/ktx2        "access plus 1 month"
  ExpiresByType application/wasm  "access plus 1 month"
  ExpiresByType text/css          "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2        "access plus 1 year"
</IfModule>
